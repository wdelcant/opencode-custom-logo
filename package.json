{
  "name": "opencode-custom-logo",
  "version": "0.1.9",
  "description": "OpenCode TUI plugin that lets users display their own ASCII art logo on the home screen",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdelcant/opencode-custom-logo.git"
  },
  "bugs": {
    "url": "https://github.com/wdelcant/opencode-custom-logo/issues"
  },
  "homepage": "https://github.com/wdelcant/opencode-custom-logo#readme",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/tui.js",
  "types": "./dist/tui.d.ts",
  "oc-plugin": "tui",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsup --watch"
  },
  "keywords": [
    "opencode",
    "plugin",
    "tui",
    "logo",
    "ascii-art",
    "custom-logo"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.50 <2",
    "@opentui/core": ">=0.4.0 <0.5",
    "@opentui/solid": ">=0.4.0 <0.5",
    "solid-js": ">=1.9.12 <2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.11",
    "@opentui/core": "^0.4.0",
    "@opentui/solid": "^0.4.0",
    "@types/node": "^26.1.1",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9.12",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
